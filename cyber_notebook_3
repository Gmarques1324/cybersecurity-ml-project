    {
      "cell_type": "markdown",
      "source": [
        "### **2.1 Função que cria um exemplo**"
      ],
      "metadata": {
        "id": "7WgtANo1WeCK"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def gerar_exemplo():\n",
        "    f1_a = round(random.uniform(0.2, 0.95), 3)\n",
        "    f1_b = round(random.uniform(0.2, 0.95), 3)\n",
        "\n",
        "    acc_a = round(min(0.99, f1_a + random.uniform(-0.05, 0.05)), 3)\n",
        "    acc_b = round(min(0.99, f1_b + random.uniform(-0.05, 0.05)), 3)\n",
        "\n",
        "    diff = abs(f1_a - f1_b)\n",
        "\n",
        "    input_text = f\"\"\"\n",
        "Modelo A:\n",
        "Accuracy = {acc_a}\n",
        "F1 weighted = {f1_a}\n",
        "\n",
        "Modelo B:\n",
        "Accuracy = {acc_b}\n",
        "F1 weighted = {f1_b}\n",
        "\"\"\"\n",
        "\n",
        "    if f1_a > f1_b:\n",
        "        melhor = \"Modelo A\"\n",
        "        melhor_f1 = f1_a\n",
        "    else:\n",
        "        melhor = \"Modelo B\"\n",
        "        melhor_f1 = f1_b\n",
        "\n",
        "    # várias formas de anunciar o vencedor\n",
        "    aberturas = [\n",
        "        f\"O {melhor} destacou-se como a arquitetura mais eficaz.\",\n",
        "        f\"A análise evidencia vantagem do {melhor}.\",\n",
        "        f\"Observa-se superioridade do {melhor} face ao comparativo.\",\n",
        "        f\"O desempenho mais robusto foi registado pelo {melhor}.\",\n",
        "    ]\n",
        "\n",
        "    frase = random.choice(aberturas)\n",
        "    frase += f\" O valor de F1 weighted atingiu {melhor_f1:.3f}. \"\n",
        "\n",
        "    # várias interpretações possíveis\n",
        "    if diff < 0.02:\n",
        "        conclusoes = [\n",
        "            \"Apesar disso, os resultados entre modelos permanecem muito próximos.\",\n",
        "            \"Contudo, a diferença observada é praticamente residual.\",\n",
        "            \"Ainda assim, a proximidade dos valores sugere limitações estruturais.\",\n",
        "        ]\n",
        "    elif melhor_f1 > 0.8:\n",
        "        conclusoes = [\n",
        "            \"O sistema demonstra forte capacidade de generalização.\",\n",
        "            \"Os indicadores apontam elevada robustez operacional.\",\n",
        "            \"O classificador revela comportamento estável em múltiplos cenários.\",\n",
        "        ]\n",
        "    elif melhor_f1 > 0.5:\n",
        "        conclusoes = [\n",
        "            \"O desempenho pode ser considerado satisfatório.\",\n",
        "            \"Os resultados são aceitáveis, embora haja espaço para evolução.\",\n",
        "            \"Verifica-se performance moderada com potencial de melhoria.\",\n",
        "        ]\n",
        "    else:\n",
        "        conclusoes = [\n",
        "            \"Os valores evidenciam a complexidade do problema.\",\n",
        "            \"A baixa performance sugere dificuldade na separação das classes.\",\n",
        "            \"Observa-se limitação significativa na capacidade preditiva.\",\n",
        "        ]\n",
        "\n",
        "    frase += random.choice(conclusoes)\n",
        "\n",
        "    return input_text.strip(), frase.strip()\n"
      ],
